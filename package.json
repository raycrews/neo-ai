{
  "name": "neo-ai",
  "productName": "Neo-AI",
  "version": "0.9.52",
  "description": "A word processor for authors. Distraction-free by default.",
  "homepage": "https://github.com/raycrews/neo-ai",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:panes": "electron scripts/test-panes.cjs",
    "test:settings": "electron scripts/test-settings.cjs",
    "test:chat": "electron scripts/test-chat.cjs",
    "test:formatting": "electron scripts/test-formatting.cjs",
    "test:context-menu": "electron scripts/test-context-menu.cjs",
    "test:search": "electron scripts/test-search.cjs",
    "test:export": "electron scripts/test-export.cjs",
    "test:revision": "electron scripts/test-revision.cjs",
    "test:general": "electron scripts/test-general.cjs",
    "package:mac": "electron-builder --mac --arm64",
    "package": "electron-builder --mac --arm64",
    "test:packaged-mac": "node scripts/test-packaged-mac.cjs",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux",
    "test:instruction-library": "electron scripts/test-instruction-library.cjs",
    "test:menus": "electron scripts/test-menus.cjs",
    "test:setup-options": "electron scripts/test-setup-options.cjs",
    "test:clean-start": "electron scripts/test-clean-start.cjs",
    "package:appimage": "electron-builder --linux AppImage --x64 --publish never",
    "test:appimage": "bash scripts/test-appimage-displays.sh",
    "package:flatpak": "electron-builder --linux flatpak --x64 --publish never",
    "test:flatpak": "node scripts/test-packaged-linux.cjs --flatpak",
    "check:privacy": "node build/privacy-check.cjs",
    "pretest": "npm run check:privacy"
  },
  "build": {
    "afterPack": "build/after-pack.cjs",
    "appId": "io.github.raycrews.neoai",
    "productName": "Neo-AI",
    "artifactName": "Neo-AI-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "raycrews",
      "repo": "neo-ai"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A distraction-free word processor for authors",
      "desktop": {
        "entry": {
          "Comment": "A word processor for authors. Distraction-free by default.",
          "Keywords": "writing;writer;novel;book;author;manuscript;wordprocessor;"
        }
      },
      "maintainer": "raycrews",
      "executableName": "neo-ai",
      "icon": "build/icons",
      "syncDesktopName": true
    },
    "portable": {
      "unpackDirName": true
    },
    "nsis": {
      "artifactName": "Neo-AI-${version}-${os}-${arch}-Setup.${ext}",
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "allowElevation": false,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!pocket/**",
      "!dist/**",
      "!Backups/**",
      "!*.md",
      "!.github/**",
      "!scripts/**",
      "!tests/**",
      "!locales/_template.json",
      "!tools/**",
      "!docs/**",
      "!**/NEO Library/**",
      "!**/Neo-AI Library/**",
      "!**/Neo-AI Library-*/**",
      "!**/book-*/**",
      "!**/Backups/**",
      "!**/Exports/**",
      "!**/userData/**",
      "!**/profiles/**",
      "!**/.aws/**",
      "!**/.ssh/**",
      "!**/library.json",
      "!**/book.json",
      "!**/ai-chats.json",
      "!**/darlings.json",
      "!**/stickies.json",
      "!**/art.json",
      "!**/settings.json",
      "!**/secrets.json",
      "!**/ai-connections.json",
      "!**/ai-assistants.json",
      "!**/instruction-library.json",
      "!**/profile-location.json",
      "!**/fresh-setup-request",
      "!**/library.json.*",
      "!**/book.json.*",
      "!**/ai-chats.json.*",
      "!**/darlings.json.*",
      "!**/stickies.json.*",
      "!**/art.json.*",
      "!**/settings.json.*",
      "!**/secrets.json.*",
      "!**/ai-connections.json.*",
      "!**/ai-assistants.json.*",
      "!**/instruction-library.json.*",
      "!**/profile-location.json.*",
      "!**/fresh-setup-request.*",
      "!**/.env",
      "!**/.env.*",
      "!**/neo-backup-*.zip",
      "!**/neo-manual-*.zip",
      "!**/*.p12",
      "!**/*.pfx",
      "!**/*.key",
      "!**/*.pem",
      "!**/*.keystore",
      "!**/id_rsa*",
      "!**/id_ed25519*",
      "!**/id_ecdsa*"
    ],
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "branch": "stable",
      "finishArgs": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--filesystem=home",
        "--filesystem=/mnt",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=xdg-run/gvfs",
        "--talk-name=org.freedesktop.secrets",
        "--env=ELECTRON_TRASH=gio"
      ],
      "files": [
        [
          "build/flatpak-display.sh",
          "/bin/neo-display-backend"
        ],
        [
          "build/io.github.raycrews.neoai.metainfo.xml",
          "/share/metainfo/io.github.raycrews.neoai.metainfo.xml"
        ]
      ],
      "executableArgs": [
        "--ozone-platform=\"$(sh /app/bin/neo-display-backend)\""
      ]
    },
    "beforePack": "build/before-pack.cjs"
  },
  "author": "Hugh Howey",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dictionary-de": "^3.0.0",
    "dictionary-en-au": "^3.0.0",
    "dictionary-en-ca": "^3.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-en-us": "^2.2.1",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "markdown-it": "15.0.2",
    "nspell": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "engines": {
    "node": ">=24 <25"
  },
  "desktopName": "io.github.raycrews.neoai.desktop"
}
